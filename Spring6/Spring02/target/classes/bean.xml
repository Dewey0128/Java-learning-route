<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xmlns:p="http://www.springframework.org/schema/p"
       xsi:schemaLocation="http://www.springframework.org/schema/util
            http://www.springframework.org/schema/util/spring-util.xsd
            http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean id="user" class="com.george.pojo.User"/>

    <!---->
    <bean id="studentPersonDao" class="com.george.pojo.StudentPersonDaoImpl"/>
    <!--expected single matching bean but found 2
        一个接口有多个实现类，这些实现类都配置了 Bean，不可以根据接口类型获取 Bean
    <bean id="teacherPersonDao" class="com.george.pojo.TeacherPersonDaoImpl"/>-->

    <!-- 依赖注入 -->
    <!-- 1. setter注入 -->
    <bean id="book" class="com.george.pojo.Book">
        <property name="author" value="周坤"/>
        <property name="name" value="Java"/>
    </bean>

    <!-- 2. 有参构造器注入-->
    <bean id="bookCon" class="com.george.pojo.Book">
        <constructor-arg name="name" value="有参构造器"/>
        <constructor-arg name="author" value="zk"/>
    </bean>

    <!-- 3. 引入对象类型依赖 -->
    <!-- 3.1 引入外部bean -->
    <bean id = "dept" class="com.george.pojo.objectBean.Department">
        <property name="name" value="财务部"/>
    </bean>
    <bean id = "emp" class="com.george.pojo.objectBean.Employee">
        <property name="name" value="lukcy"/>
        <property name="age" value="18"/>
        <!--引入外部bean 使用 ref 属性 -->
        <property name="department" ref="dept"/>
    </bean>

    <!-- 3.2 内部Bean -->
    <bean id = "empInner" class="com.george.pojo.objectBean.Employee">
        <property name="name" value="Tom"/>
        <property name="age" value="22"/>
        <property name="department">
            <bean class="com.george.pojo.objectBean.Department">
                <property name="name" value="安保部"/>
            </bean>
        </property>
    </bean>

    <!-- 4.注入集合类型Bean -->
    <bean id="less1" class="com.george.pojo.collections.Lession">
        <property name="LId" value="01"/>
        <property name="LName" value="C++教程"/>
    </bean>
    <bean id="less2" class="com.george.pojo.collections.Lession">
        <property name="LId" value="02"/>
        <property name="LName" value="Java入门"/>
    </bean>
    <bean id="teach1" class="com.george.pojo.collections.Teacher">
        <property name="TId" value="001"/>
        <property name="TName" value="欧阳"/>
    </bean>
    <bean id="teach2" class="com.george.pojo.collections.Teacher">
        <property name="TId" value="002"/>
        <property name="TName" value="西门"/>
    </bean>

    <util:list id="lession">
        <ref bean="less1"/>
        <ref bean="less2"/>
    </util:list>
    <util:map id="teacher">
        <entry key="老师1号" value-ref="teach1"/>
        <entry key="老师2号" value-ref="teach2"/>
    </util:map>

    <bean id="std" class="com.george.pojo.collections.Student">
        <property name="SID" value="1"/>
        <property name="SName" value="Lucy"/>
        <property name="lessionList" ref="lession"/>
        <property name="teacherMap" ref="teacher"/>
    </bean>

    <!-- 5. p命名空间注入 -->
    <bean id="stdp" class="com.george.pojo.collections.Student"
          p:SID="2"
          p:SName="Tom"
          p:lessionList-ref="lession"
          p:teacherMap-ref="teacher"/>


</beans>